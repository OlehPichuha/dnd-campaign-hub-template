{
  "name": "campaign-hub-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174",
    "build": "tsc --noEmit && vite build",
    "preview": "wrangler dev --ip 127.0.0.1 --port 8790",
    "db:local": "wrangler d1 migrations apply campaign-template-db --local",
    "db:remote": "wrangler d1 migrations apply campaign-template-db --remote",
    "content:local": "node scripts/sync-library-content.mjs --local",
    "content:remote": "node scripts/sync-library-content.mjs --remote",
    "covers:build": "node scripts/build-template-covers.mjs",
    "test": "node --test tests/*.test.mjs",
    "deploy": "npm run build && node scripts/deploy-check.mjs && wrangler deploy"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "hono": "4.13.8",
    "jose": "6.2.12",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260919.1",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "jsdom": "^30.1.1",
    "miniflare": "5.20260918.0-alpha",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "wrangler": "4.135.0"
  }
}
